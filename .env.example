# URL do sistema: o botão "Acessar o sistema" aponta para ela
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL pública deste site (metadataBase, sitemap e imagem de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Formulário de contato, enviado pelo SMTP do Zoho Mail. Só no servidor: nunca usar o prefixo NEXT_PUBLIC_.
# SMTP_USER é a caixa que envia (ex.: site@murel.com.br). SMTP_PASSWORD é uma senha de aplicativo do Zoho, não a senha da conta.
SMTP_USER=
SMTP_PASSWORD=

# Opcionais. Padrão: smtp.zoho.com, porta 465 (SSL). Contas com domínio próprio costumam usar smtppro.zoho.com.
SMTP_HOST=
SMTP_PORT=
# Opcional. Padrão: SMTP_USER. O Zoho só aceita o endereço da conta ou um alias dela.
EMAIL_REMETENTE=
CONTATO_DESTINO=contato@murel.com.br
