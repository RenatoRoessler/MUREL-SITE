# URL do sistema: o botão "Acessar o sistema" aponta para ela e "Ir para adesão" para <URL>/adesao
NEXT_PUBLIC_APP_URL=http://localhost:3000

# URL pública deste site (metadataBase, sitemap e imagem de compartilhamento)
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Formulário de contato. Só no servidor: nunca usar o prefixo NEXT_PUBLIC_ nestas variáveis.
EMAIL_API_KEY=
EMAIL_REMETENTE=
CONTATO_DESTINO=contato@murel.com.br
